{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "postcss.config.cjs",
    "tailwind.config.cjs"
  ]
}